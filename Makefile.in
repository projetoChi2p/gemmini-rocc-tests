prefix		:= /usr/local
abs_top_srcdir	:= /home/luismendes/chipyard/generators/gemmini/software/gemmini-rocc-tests/build/..
XLEN            := 64
RISCVTOOLS      := @RISCVTOOLS@
ROCC = examples
RUNNER         := "spike --extension=gemmini "

# .PHONY: all bareMetalC clean imagenet transformers mlps vit quantization ViTRuns
# all: bareMetalC imagenet transformers mlps vit quantization ViTRuns

.PHONY: all bareMetalC quantization ViTRuns CNNs
all: bareMetalC quantization ViTRuns CNNs


vars = \
	abs_top_srcdir=$(abs_top_srcdir) \
	XLEN=$(XLEN) \
	PREFIX=$(ROCC)-$@ \
	src_dir=$(abs_top_srcdir)/$@ \
	RISCVTOOLS=$(RISCVTOOLS)

bareMetalC:
	mkdir -p $@
	$(MAKE) -C $@ -f $(abs_top_srcdir)/$@/Makefile $(vars)

imagenet:
	mkdir -p $@
	$(MAKE) -C $@ -f $(abs_top_srcdir)/$@/Makefile $(vars)

transformers:
	mkdir -p $@
	$(MAKE) -C $@ -f $(abs_top_srcdir)/$@/Makefile $(vars)

mlps:
	mkdir -p $@
	$(MAKE) -C $@ -f $(abs_top_srcdir)/$@/Makefile $(vars)

vit:
	mkdir -p $@
	$(MAKE) -C $@ -f $(abs_top_srcdir)/$@/Makefile $(vars)

quantization:
	mkdir -p $@
	$(MAKE) -C $@ -f $(abs_top_srcdir)/$@/Makefile $(vars)

ViTRuns:
	mkdir -p $@
	$(MAKE) -C $@ -f $(abs_top_srcdir)/$@/Makefile $(vars)

CNNs:
	mkdir -p $@
	$(MAKE) -C $@ -f $(abs_top_srcdir)/$@/Makefile $(vars)

clean:
	$(MAKE) -C bareMetalC -f $(abs_top_srcdir)/bareMetalC/Makefile abs_top_srcdir=$(abs_top_srcdir) PREFIX=$(ROCC)-bareMetalC clean
	$(MAKE) -C imagenet -f $(abs_top_srcdir)/imagenet/Makefile abs_top_srcdir=$(abs_top_srcdir) PREFIX=$(ROCC)-imagenet clean
	$(MAKE) -C mlps -f $(abs_top_srcdir)/mlps/Makefile abs_top_srcdir=$(abs_top_srcdir) PREFIX=$(ROCC)-mlps clean
	$(MAKE) -C vit -f $(abs_top_srcdir)/vit/Makefile abs_top_srcdir=$(abs_top_srcdir) PREFIX=$(ROCC)-vit clean
	$(MAKE) -C quantization -f $(abs_top_srcdir)/quantization/Makefile abs_top_srcdir=$(abs_top_srcdir) PREFIX=$(ROCC)-quantization clean
	$(MAKE) -C ViTRuns -f $(abs_top_srcdir)/ViTRuns/Makefile abs_top_srcdir=$(abs_top_srcdir) PREFIX=$(ROCC)-ViTRuns clean
	$(MAKE) -C CNNs -f $(abs_top_srcdir)/CNNs/Makefile abs_top_srcdir=$(abs_top_srcdir) PREFIX=$(ROCC)-CNNs clean

test-baremetal-bareMetalC:
	make -C bareMetalC	\
	        -f $(abs_top_srcdir)/bareMetalC/Makefile \
                TARGET_MAKEFILE=$(abs_top_srcdir)/bareMetalC/Makefile \
		abs_top_srcdir=$(abs_top_srcdir) \
	 	src_dir=$(abs_top_srcdir)/bareMetalC \
	 	XLEN=$(XLEN) \
	 	PREFIX=$(ROCC)-bareMetalC \
		RISCVTOOLS=$(RISCVTOOLS) \
		RUNNER=$(RUNNER) \
		run-baremetal

test-baremetal: test-baremetal-bareMetalC
#	make -C mlps	\
	        -f $(abs_top_srcdir)/mlps/Makefile \
                TARGET_MAKEFILE=$(abs_top_srcdir)/mlps/Makefile \
		abs_top_srcdir=$(abs_top_srcdir) \
	 	src_dir=$(abs_top_srcdir)/mlps \
	 	XLEN=$(XLEN) \
	 	PREFIX=$(ROCC)-mlps \
		RISCVTOOLS=$(RISCVTOOLS) \
		RUNNER=$(RUNNER) \
	        run-baremetal
#	make -C imagenet	\
	        -f $(abs_top_srcdir)/imagenet/Makefile \
                TARGET_MAKEFILE=$(abs_top_srcdir)/imagenet/Makefile \
		abs_top_srcdir=$(abs_top_srcdir) \
	 	src_dir=$(abs_top_srcdir)/imagenet \
	 	XLEN=$(XLEN) \
	 	PREFIX=$(ROCC)-imagenet \
		RISCVTOOLS=$(RISCVTOOLS) \
		RUNNER=$(RUNNER) \
		run-baremetal

#	make -C vit	\
	        -f $(abs_top_srcdir)/vit/Makefile \
                TARGET_MAKEFILE=$(abs_top_srcdir)/vit/Makefile \
		abs_top_srcdir=$(abs_top_srcdir) \
	 	src_dir=$(abs_top_srcdir)/vit \
	 	XLEN=$(XLEN) \
	 	PREFIX=$(ROCC)-vit \
		RISCVTOOLS=$(RISCVTOOLS) \
		RUNNER=$(RUNNER) \
		run-baremetal

	make -C quantization	\
	        -f $(abs_top_srcdir)/quantization/Makefile \
                TARGET_MAKEFILE=$(abs_top_srcdir)/quantization/Makefile \
		abs_top_srcdir=$(abs_top_srcdir) \
	 	src_dir=$(abs_top_srcdir)/quantization \
	 	XLEN=$(XLEN) \
	 	PREFIX=$(ROCC)-quantization \
		RISCVTOOLS=$(RISCVTOOLS) \
		RUNNER=$(RUNNER) \
		run-baremetal

	make -C ViTRuns	\
	        -f $(abs_top_srcdir)/ViTRuns/Makefile \
                TARGET_MAKEFILE=$(abs_top_srcdir)/ViTRuns/Makefile \
		abs_top_srcdir=$(abs_top_srcdir) \
	 	src_dir=$(abs_top_srcdir)/ViTRuns \
	 	XLEN=$(XLEN) \
	 	PREFIX=$(ROCC)-ViTRuns \
		RISCVTOOLS=$(RISCVTOOLS) \
		RUNNER=$(RUNNER) \
		run-baremetal

	make -C CNNs	\
	        -f $(abs_top_srcdir)/CNNs/Makefile \
				TARGET_MAKEFILE=$(abs_top_srcdir)/CNNs/Makefile \
		abs_top_srcdir=$(abs_top_srcdir) \
	 	src_dir=$(abs_top_srcdir)/CNNs \
	 	XLEN=$(XLEN) \
	 	PREFIX=$(ROCC)-CNNs \
		RISCVTOOLS=$(RISCVTOOLS) \
		RUNNER=$(RUNNER) \
		run-baremetal


